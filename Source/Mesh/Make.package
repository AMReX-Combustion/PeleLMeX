## Mesh mapping: the MeshMap base class, its device-callable coordinate
## evaluator, the concrete maps, and the mesh-mapped state interpolator.
##
## Wired in through LMdirs in Exec/Make.PeleLMeX, which adds this directory
## to both INCLUDE_LOCATIONS and VPATH_LOCATIONS, so the sources here keep
## using plain <PeleLMeX_*.H> includes.

## Header
CEXE_headers += PeleLMeX_MeshMap.H
CEXE_headers += PeleLMeX_MeshMapEvaluator.H
CEXE_headers += PeleLMeX_ConstantMap.H
CEXE_headers += PeleLMeX_ExpStretchMap.H
CEXE_headers += PeleLMeX_TanhStretchMap.H
CEXE_headers += PeleLMeX_InteriorStretchMap.H
CEXE_headers += PeleLMeX_MeshMappedCellConsInterp.H

## Sources
CEXE_sources += PeleLMeX_MeshMap.cpp
CEXE_sources += PeleLMeX_ConstantMap.cpp
CEXE_sources += PeleLMeX_ExpStretchMap.cpp
CEXE_sources += PeleLMeX_TanhStretchMap.cpp
CEXE_sources += PeleLMeX_InteriorStretchMap.cpp
CEXE_sources += PeleLMeX_MeshMappedCellConsInterp.cpp
