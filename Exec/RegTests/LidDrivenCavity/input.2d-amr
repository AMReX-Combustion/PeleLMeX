# =====================================================================
# 2D lid-driven cavity, Re = 100, TanhStretchMap (beta = 2 2) + AMR
# =====================================================================
#
# AMR SMOKE TEST for the mesh-mapping branch.  Identical numerics to
# input.2d (the Re = 100 single-level baseline) but with one level of
# AMR refinement enabled.
#
# Refinement strategy (deterministic, fixed-region):
#   - Box refinement covers the upper quarter of the cavity
#     [0.0, 1.0] x [0.75, 1.0].  This deliberately straddles both
#     corner singularities (where |omega| -> infty) and the lid
#     boundary layer.  It also includes a stretch of interior fluid
#     so the coarse-fine boundary cuts through smooth flow regions,
#     making conservation diagnostics easier to read.
#   - One additional vorticity-based indicator catches the corner
#     plumes if they migrate beyond the box during early transients;
#     threshold is conservative for Re = 100.
#
# What to look for when running:
#   (1) The driver should report "Mesh mapping enabled: TanhStretchMap"
#       in the header (verifies the m_mesh_mapping bool fix is live).
#   (2) Both projection solvers should converge.  Watch the verbose
#       output for:
#         "nodal_projection ... iters = N residual = ..."   (composite)
#         "mac_projection   ... iters = N residual = ..."   (composite)
#       Compare iteration counts to the single-level run.  A modest
#       increase is expected; a runaway count means composite-MLMG
#       restriction across the C/F boundary is misbehaving under
#       anisotropic sigma / beta.
#   (3) Visual inspection: plot the y = 0.75 line in postprocess_cavity
#       on the AMR plotfile.  The velocity profile should be smooth
#       across the C/F interface.  Visible kink ==> the mass-aware
#       coarse-fine interpolator (Phase 1) is needed.
#   (4) Centreline profiles at x = 0.5 and y = 0.5 should still match
#       Ghia within the same tolerance as single-level.  Significant
#       deviation localised near y = 0.75 means C/F-interface
#       conservation error; deviation everywhere means a deeper
#       projection issue.
# ---------------------------------------------------------------------

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 1.0 1.0 1.0

peleLM.lo_bc = NoSlipWallAdiab NoSlipWallAdiab
peleLM.hi_bc = NoSlipWallAdiab Inflow

#----------------------- AMR controls --------------------------
amr.n_cell          = 64 64
amr.v               = 1
amr.max_level       = 1               # one level of refinement
amr.ref_ratio       = 2 2             # 2:1 in each direction
amr.blocking_factor = 8               # was 16 single-level; finer
                                      # boxes needed at lev 1
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2             # buffer cells around tagged
amr.grid_eff        = 0.7
amr.regrid_int      = 5               # regrid every 5 steps

#----------------------- Refinement criteria --------------------
# 1. Fixed-box refinement in the upper quarter [0,1] x [0.75,1].
# 2. Vorticity-magnitude indicator as a safety net.
amr.refinement_indicators = upperBox magvort

amr.upperBox.max_level   = 1
amr.upperBox.in_box_lo   = 0.0  0.75
amr.upperBox.in_box_hi   = 1.0  1.0

amr.magvort.max_level     = 1
amr.magvort.value_greater = 50.0      # rough; tune after first run
amr.magvort.field_name    = mag_vort

#----------------------- Mesh mapping --------------------------
geometry.mesh_mapping = TanhStretchMap
TanhStretchMap.beta   = 2.0 2.0

#----------------------- Problem -------------------------------
prob.U_lid = 1.0

#----------------------- PeleLM controls -----------------------
peleLM.v              = 2
peleLM.incompressible = 1
peleLM.rho            = 1.0
peleLM.mu             = 0.01           # Re = 100
peleLM.gradP0         = 0.0 0.0 0.0
peleLM.gravity        = 0.0 0.0 0.0

#----------------------- Time stepping -------------------------
amr.cfl       = 0.7
amr.dt_shrink = 0.1
amr.init_dt   = 1.0e-4
amr.max_dt    = 5.0e-3
amr.max_step  = 5000000
amr.stop_time = 50.0
amr.plot_int  = 5000
amr.plot_file = plt_amr_
amr.check_int = -1
amr.derive_plot_vars = mag_vort

#----------------------- Linear solvers ------------------------
# At beta = 2 the MAC operator's anisotropy (cosh^2(2) = 14.15)
# requires BoomerAMG to handle the corner-singularity coupling;
# the MAC bottom path uses HypreMLABecLap (use_mlhypre = 1).
#
# For the NODAL projection, hypre as the bottom solver triggers a
# non-deterministic NaN inside hypre BoomerAMG after several hundred
# steps in the AMR + mesh-mapping configuration (observed at step
# ~654 with hypre 2.32.0 on macOS arm64).  The MLMG iteration matrix
# and rhs are essentially constant across steps for incompressible
# cavity, so the failure is most likely a hypre-internal numerical
# or memory issue, not a PeleLMeX correctness problem (bicgstab as
# bottom solver runs thousands of steps past 654 with the same
# operator and rhs).  Use bicgstab here until the hypre issue is
# upstream-fixed.
mac_proj.use_mlhypre     = 1
nodal_proj.bottom_solver = bicgstab
nodal_proj.maxiter       = 10000
nodal_proj.rtol          = 1.0e-7

nodal_proj.verbose = 1
mac_proj.verbose   = 1

#----------------------- Plotfile metadata ---------------------
peleLM.plot_mesh_mapping = 1

#----------------------- Diagnostics ---------------------------
amrex.fpe_trap_invalid  = 0
amrex.fpe_trap_zero     = 0
amrex.fpe_trap_overflow = 0
