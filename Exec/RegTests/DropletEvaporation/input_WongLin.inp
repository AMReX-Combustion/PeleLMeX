#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 1 0               # For each dir, 0: non-perio, 1: periodic
geometry.coord_sys   = 0                  # 0 => cart, 1 => RZ
geometry.prob_lo     = 0.0 0.0 0.0        # x_lo y_lo (z_lo)
geometry.prob_hi     = 1. 1. 1.        # x_hi y_hi (z_hi)

#--------------------------BC FLAGS------------------------------
# Interior, Inflow, Outflow, Symmetry,
# SlipWallAdiab, NoSlipWallAdiab, SlipWallIsotherm, NoSlipWallIsotherm
peleLM.lo_bc = Inflow SlipWallAdiab
peleLM.hi_bc = Outflow SlipWallAdiab

#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 128 128 128         # Level 0 number of cells in each direction
amr.v               = 1                # AMR verbose
amr.max_level       = 0                # maximum level number allowed
amr.blocking_factor = 16               # block factor in grid generation (min box size)
amr.max_grid_size   = 64               # max box size

#--------------------------Problem--------------------------------
prob.P_mean        = 101325.
prob.init_redist   = 0
prob.init_T        = 1000 # K
prob.init_vel      = 0.
prob.num_particles = (1, 1, 1)
prob.part_temp     = 315.
prob.part_dia      = 1.961E-3
prob.part_vel      = 0. 0. 0.
prob.part_Re       = 17

#------------------------PeleLM CONTROL-----------------------------
peleLM.v = 1
#peleLM.sdc_iterMax = 2
peleLM.deltaT_verbose = 1
peleLM.deltaT_iterMax = 1000
peleLM.deltaT_crashIfFailing = 1

peleLM.do_temporals = 0
peleLM.num_init_iter = 0

#------------------------TIME STEPPING------------------------------
#amr.max_step = 1
amr.stop_time = 4 # K
amr.fixed_dt = 1e-2

#--------------------------IO CONTROL-------------------------------
amr.plot_file = "WongLin/plt"
amr.plot_int = 10
amr.plot_speciesState = 1
amr.plot_grad_p = 0
amr.derive_plot_vars = mass_fractions

# -----------------------LINEAR SOLVERS-----------------------------
mac_proj.verbose = 2
mac_proj.maxiter = 2000
mac_proj.rtol = 1.0e-9
nodal_proj.verbose = 1
diffusion.verbose = 0


# ------------------INPUTS TO CHEMISTRY REACTOR---------------------
peleLM.chem_integrator = "ReactorNull"

#--------------------SPRAY PARTICLE DATA-----------------------
peleLM.do_spray_particles = 1
particles.derive_plot_vars = 1
particles.write_ascii_files = 1
particles.v             = 0
particles.cfl           = 1.
particles.fixed_parts   = 1
particles.mom_transfer  = 1
particles.mass_transfer = 1

particles.fuel_species = NC10H22
particles.fuel_ref_temp = 298.15

# Properties for decane, in MKS
particles.NC10H22_crit_temp = 617.8 # K
particles.NC10H22_boil_temp = 447.27 # K
particles.NC10H22_latent = 3.5899E5
particles.NC10H22_cp = 2.1921E3 # Cp at 298 K
particles.NC10H22_rho = 726.53
# Coefficients for saturation pressure using Antoine equation
# These are from the NIST website
# Last coefficient converts units, in this case bar, to Pa
particles.NC10H22_psat = 4.07857 1501.268 -78.67 1.E5

